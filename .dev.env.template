# 编译期环境变量模板
#
# 用法：复制本文件，填入真实值
#   cp .dev.env.template .dev.env    # 本地调试（flutter run / run_simulator.sh）
#   cp .dev.env.template .prod.env   # 发布（release_*.sh），将 API_BASE_URL 设为全球生产 API
#
# 编译时通过 --dart-define-from-file=.dev.env|.prod.env 注入。
# .dev.env / .prod.env 已被 .gitignore，不会提交，请勿把真实密钥写进本模板。

# Supabase 项目地址与 publishable key（认证依赖）
SUPABASE_URL=
CHINA_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google 登录的 Web Client ID（如不使用可留空）
GOOGLE_WEB_CLIENT_ID=

# 全球 API 地址覆盖；开发默认使用 dev 地址，发布配置请改为全球生产地址。
API_BASE_URL=https://dev.echo-loop.top

# 中国 API 地址；release 包按运行时地区选择此地址，默认值为该生产域名。
API_CHINA_BASE_URL=https://dev.echo-loop.cn

# RevenueCat 公开 SDK API Key（订阅，按平台填；留空则订阅不可用但 app 仍可运行）
# 来源：RevenueCat 后台 → Project settings → API keys
REVENUECAT_API_KEY_APPLE=
REVENUECAT_API_KEY_GOOGLE=
# Premium 的 entitlement 标识，需与 RevenueCat 后台一致，默认 premium 可不填
REVENUECAT_ENTITLEMENT_ID=
